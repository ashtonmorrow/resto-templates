---
import '../styles/tokens.css';
import '../styles/global.css';
interface Props {
  title: string;
  theme: string;
  description?: string;
  image?: string | null;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
}
const {
  title,
  theme,
  description,
  image = '/og.png',
  structuredData,
  ogType = 'website',
  datePublished,
  dateModified,
} = Astro.props;
const ogImage = image ? new URL(image, Astro.site) : null;
const isFolioPreview = image === '/og.png';
const ogImageAlt = isFolioPreview ? 'Folio: Aprendé a construir con IA' : title;
const ogImageType = image?.endsWith('.png') ? 'image/png' : image?.endsWith('.jpg') || image?.endsWith('.jpeg') ? 'image/jpeg' : null;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = structuredData
  ? JSON.stringify(
      Array.isArray(structuredData)
        ? { '@context': 'https://schema.org', '@graph': structuredData }
        : structuredData,
    ).replace(/</g, '\\u003c')
  : null;
const fontFamilies: Record<string, string[]> = {
  studio: ['Inter:wght@400;500;600;700;800;900'],
  ember: ['Bebas+Neue', 'Inter:wght@400;500;600;700'],
  heritage: ['Playfair+Display:ital,wght@0,600;0,900;1,600', 'Libre+Baskerville:ital@0;1'],
  minimal: ['Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500', 'Inter:wght@400;500;600;700'],
  airy: ['DM+Serif+Display:ital@0;1', 'DM+Sans:wght@400;500;700'],
  luxe: ['Cormorant+Garamond:ital,wght@0,500;0,600;1,500', 'Inter:wght@400;500;600;700'],
  bold: ['Anton', 'Work+Sans:wght@400;600;700'],
  playful: ['Space+Grotesk:wght@400;500;700'],
  cinematic: ['Playfair+Display:ital,wght@0,600;0,900;1,600', 'Inter:wght@400;500;600;700'],
  wine: ['Cormorant+Garamond:ital,wght@0,500;0,600;1,500', 'Inter:wght@400;500;600;700'],
  sweet: ['Baloo+2:wght@500;700;800', 'Manrope:wght@400;600;800'],
  mono: ['Space+Grotesk:wght@400;500;700'],
  clean: ['Manrope:wght@400;600;800'],
  gallery: ['Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500', 'Inter:wght@400;500;600;700'],
  convert: ['Manrope:wght@400;600;800', 'Inter:wght@400;500;600;700'],
  warm: ['Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500', 'Work+Sans:wght@400;600;700'],
};
const fonts = `https://fonts.googleapis.com/css2?${(fontFamilies[theme] ?? fontFamilies.studio).map((family) => `family=${family}`).join('&')}&display=swap`;
const colorScheme = ['ember', 'luxe', 'cinematic', 'wine'].includes(theme) ? 'dark' : 'light';
---
<!doctype html>
<html lang="es-AR" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={colorScheme} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Folio" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {isFolioPreview && <meta property="og:image:width" content="1200" />}
    {isFolioPreview && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    {ogType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
    {ogType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="author" content="Folio" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
  </body>
</html>
