---
import '../styles/tokens.css';
import '../styles/global.css';
interface Props {
  title: string;
  theme: string;
  description?: string;
}
const { title, theme, description } = Astro.props;
const fonts =
  'https://fonts.googleapis.com/css2?family=Anton&family=Baloo+2:wght@500;700;800&family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital@0;1&family=Manrope:wght@400;600;800&family=Playfair+Display:ital,wght@0,600;0,900;1,600&family=Space+Grotesk:wght@400;500;700&family=Work+Sans:wght@400;600;700&display=swap';
---
<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
