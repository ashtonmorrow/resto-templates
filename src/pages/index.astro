---
import Base from '../layouts/Base.astro';
import StudioNav from '../components/StudioNav.astro';
import StudioFooter from '../components/StudioFooter.astro';
import { responsiveImage } from '../lib/images';

const repositoryUrl = 'https://github.com/ashtonmorrow/resto-templates';
const restaurantPreview = responsiveImage('/images/templates/01.jpg', 1512);
const steps = [
  {
    number: '01',
    title: 'Definí la página',
    description: 'Anotá el objetivo, la acción principal y el orden de los bloques antes de tocar código.',
    href: '/aprender/preparar-un-diseno/',
    action: 'Abrir el ejercicio',
  },
  {
    number: '02',
    title: 'Ubicá cada pieza',
    description: 'Abrí el repositorio y encontrá dónde viven los datos, los componentes y los estilos.',
    href: '/guias/del-diseno-a-una-web-con-ia/#paso-2',
    action: 'Entender el entorno',
  },
  {
    number: '03',
    title: 'Hacé un cambio',
    description: 'Modificá una sección, abrila en teléfono y escritorio, y revisá los archivos antes de guardarla.',
    href: '/guias/del-diseno-a-una-web-con-ia/#paso-5',
    action: 'Ver la rutina',
  },
];

const concepts = [
  ['Entorno de trabajo', 'La carpeta, sus instrucciones y los comandos que el agente tiene disponibles.'],
  ['Componentes', 'Archivos que resuelven partes concretas, como la portada, la carta o el contacto.'],
  ['Vista previa', 'La página abierta en el navegador antes de publicarla.'],
  ['Diff y build', 'Los archivos que cambiaron y la prueba de que el proyecto todavía genera una versión publicable.'],
];
---

<Base
  title="Aprendé a construir con IA | Folio"
  theme="studio"
  description="Una guía práctica para pasar del diseño al código con IA sobre un proyecto real."
  structuredData={[
    {
      '@type': 'Organization',
      '@id': 'https://folio.unwoke.ninja/#organization',
      name: 'Folio',
      url: 'https://folio.unwoke.ninja/',
      email: 'hola@unwoke.ninja',
      sameAs: [repositoryUrl],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://folio.unwoke.ninja/#website',
      url: 'https://folio.unwoke.ninja/',
      name: 'Folio',
      inLanguage: 'es-AR',
      publisher: { '@id': 'https://folio.unwoke.ninja/#organization' },
    },
    {
      '@type': 'LearningResource',
      name: 'Aprender a construir con IA',
      url: 'https://folio.unwoke.ninja/aprender/',
      inLanguage: 'es-AR',
      educationalLevel: 'Principiante',
    },
  ]}
>
  <StudioNav />

  <main id="main-content">
    <header class="home-hero wrap">
      <p class="eyebrow">Diseño y código con IA</p>
      <h1>Pasá un diseño a una web que puedas revisar.</h1>
      <div class="home-hero__intro">
        <p>Traé una pantalla de Figma, Illustrator, Photoshop, una captura o un boceto. Folio muestra cómo preparar el proyecto, pedir un cambio acotado y comprobar qué hizo el agente.</p>
        <div class="home-actions">
          <a class="home-button home-button--primary" href="/aprender/preparar-un-diseno/">Preparar una página <span>10 min</span></a>
          <a class="home-button" href="/guias/del-diseno-a-una-web-con-ia/">Leer la guía <span>Paso a paso</span></a>
        </div>
      </div>
      <div class="home-strip" aria-label="Etapas del recorrido"><span>Diseño</span><span>Proyecto</span><span>Cambio</span><span>Revisión</span></div>
    </header>

    <section class="home-path wrap">
      <div class="home-heading">
        <p class="eyebrow">Primera prueba</p>
        <h2>Empezá con una sola página.</h2>
        <p>Antes de tocar el sitio completo, hacé un cambio que entre en una revisión. Estos tres pasos sirven para repetir el mismo trabajo en otras páginas.</p>
      </div>
      <ol class="home-steps">
        {steps.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <a href={step.href}>{step.action} <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-concepts">
      <div class="wrap home-concepts__grid">
        <div>
          <p class="eyebrow">Dentro del proyecto</p>
          <h2>Cuatro cosas que vas a usar desde el primer cambio.</h2>
          <p>Las explicamos cuando aparecen en el trabajo. Después podés volver a esta lista para recordar qué comprueba cada una.</p>
        </div>
        <dl>
          {concepts.map(([term, description], index) => <div><dt><span>{String(index + 1).padStart(2, '0')}</span>{term}</dt><dd>{description}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="home-example wrap" id="ejemplo">
      <div class="home-example__copy">
        <p class="eyebrow">Proyecto 01</p>
        <h2>El primer proyecto es una web de restaurante.</h2>
        <p>Se llama Folio Resto. La carta y los horarios viven en una ficha, los bloques están separados en componentes y hay quince composiciones para comparar. El código completo está abierto.</p>
        <div class="home-actions">
          <a class="home-button home-button--primary" href="/ejemplos/">Explorar Folio Resto <span>Demo abierta</span></a>
          <a class="home-button" href="https://github.com/ashtonmorrow/resto-templates" target="_blank" rel="noreferrer">Abrir el código <span>GitHub ↗</span></a>
        </div>
      </div>
      <a class="home-example__image" href="/ejemplos/" aria-label="Abrir el ejemplo Folio Resto">
        <img src="/images/templates/01.jpg" srcset={restaurantPreview.srcset} sizes="(max-width: 840px) 100vw, 55vw" alt="Vista de una página del ejemplo Folio Resto" width="1512" height="767" loading="lazy" decoding="async" />
        <span><b>Folio Resto</b> Ver el ejemplo <i aria-hidden="true">↗</i></span>
      </a>
    </section>

    <section class="home-end">
      <div class="wrap">
        <div><p class="eyebrow">Tu turno</p><h2>Traé una página que quieras convertir.</h2></div>
        <a class="home-button home-button--primary" href="/aprender/preparar-un-diseno/">Preparar mi página <span>10 min →</span></a>
      </div>
    </section>
  </main>

  <StudioFooter />
</Base>

<style>
  .home-hero { min-height: calc(100vh - 82px); padding-block: clamp(64px, 9vw, 108px) 28px; display: flex; flex-direction: column; }
  .home-hero h1 { max-width: 1020px; margin-top: 22px; font-size: clamp(3.2rem, 7.2vw, 6.7rem); line-height: .94; letter-spacing: -.064em; font-weight: 850; }
  .home-hero__intro { width: min(690px, 100%); margin: 42px 0 50px auto; }
  .home-hero__intro > p { font-family: Georgia, serif; font-size: clamp(1.12rem, 2vw, 1.35rem); line-height: 1.62; }
  .home-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .home-button { min-height: 55px; padding: .8em 1.1em; border: 1px solid currentColor; border-radius: 4px; display: inline-flex; align-items: center; justify-content: space-between; gap: 26px; font-weight: 800; flex: 1; }
  .home-button:hover { box-shadow: 3px 3px 0 currentColor; transform: translate(-1px, -1px); }
  .home-button--primary { background: var(--acid); color: var(--text); }
  .home-button > span { font-size: .67rem; text-transform: uppercase; letter-spacing: .08em; white-space: nowrap; }
  .home-strip { margin-top: auto; padding-block: 16px; border-block: 1px solid var(--border); display: grid; grid-template-columns: repeat(4, 1fr); color: var(--muted); font-size: .69rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .home-strip span:not(:first-child) { text-align: center; }
  .home-strip span:last-child { text-align: right; }

  .home-path { padding-block: clamp(76px, 10vw, 118px); }
  .home-heading { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr); gap: 16px 60px; }
  .home-heading .eyebrow { grid-column: 1 / -1; }
  .home-heading h2, .home-concepts h2, .home-example h2, .home-end h2 { font-size: clamp(2.35rem, 4.7vw, 4.5rem); line-height: .98; letter-spacing: -.052em; font-weight: 850; }
  .home-heading > p:last-child { align-self: end; color: var(--muted); line-height: 1.65; }
  .home-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 48px; padding: 0; list-style: none; }
  .home-steps li { min-height: 300px; padding: 24px; border: 1px solid var(--text); display: flex; flex-direction: column; }
  .home-steps li > span { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .1em; }
  .home-steps h3 { margin-top: 42px; font-size: clamp(1.55rem, 2.6vw, 2.3rem); letter-spacing: -.04em; font-weight: 850; }
  .home-steps p { margin-top: 14px; color: var(--muted); font-size: .92rem; line-height: 1.6; }
  .home-steps a { margin-top: auto; padding-top: 24px; font-size: .82rem; font-weight: 800; }
  .home-steps a span { margin-left: 7px; color: var(--accent); }

  .home-concepts { padding-block: clamp(76px, 10vw, 112px); background: var(--text); color: var(--bg); }
  .home-concepts__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(48px, 8vw, 100px); }
  .home-concepts .eyebrow { color: var(--acid); }
  .home-concepts h2 { margin-top: 14px; }
  .home-concepts__grid > div > p:last-child { max-width: 560px; margin-top: 22px; color: #bbb6aa; }
  .home-concepts dl { border-top: 1px solid #57544d; }
  .home-concepts dl > div { padding-block: 18px; border-bottom: 1px solid #57544d; display: grid; grid-template-columns: .8fr 1.2fr; gap: 24px; }
  .home-concepts dt { font-weight: 800; }
  .home-concepts dt span { display: inline-block; width: 36px; color: var(--acid); font-size: .68rem; }
  .home-concepts dd { margin: 0; color: #bbb6aa; font-size: .9rem; }

  .home-example { padding-block: clamp(76px, 10vw, 116px); display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(44px, 7vw, 86px); align-items: center; }
  .home-example h2 { margin-top: 14px; }
  .home-example__copy > p:not(.eyebrow) { margin-top: 22px; color: var(--muted); line-height: 1.7; }
  .home-example__image { border: 1px solid var(--text); background: #fffaf0; box-shadow: 8px 8px 0 var(--accent-2); }
  .home-example__image img { width: 100%; height: auto; aspect-ratio: 1512 / 767; object-fit: cover; object-position: top; }
  .home-example__image > span { padding: 13px 15px; border-top: 1px solid var(--text); display: flex; gap: 12px; }
  .home-example__image b { color: var(--accent); }
  .home-example__image i { margin-left: auto; font-style: normal; }

  .home-end { padding-block: clamp(70px, 9vw, 102px); background: var(--accent); color: #fff7ed; }
  .home-end .wrap { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: end; }
  .home-end .eyebrow { color: var(--acid); }
  .home-end h2 { max-width: 760px; margin-top: 12px; }
  .home-end .home-button { min-width: 270px; }

  @media (max-width: 820px) {
    .home-heading, .home-concepts__grid, .home-example, .home-end .wrap { grid-template-columns: 1fr; }
    .home-heading > p:last-child { max-width: 600px; }
    .home-steps { grid-template-columns: 1fr; }
    .home-steps li { min-height: 0; }
    .home-steps h3 { margin-top: 25px; }
    .home-steps a { margin-top: 22px; }
    .home-example__image { width: min(680px, 100%); }
    .home-end .home-button { width: min(380px, 100%); }
  }
  @media (max-width: 540px) {
    .home-hero { min-height: 0; padding-bottom: 0; }
    .home-hero h1 { font-size: clamp(2.9rem, 14vw, 4.2rem); }
    .home-hero__intro { margin: 30px 0 44px; }
    .home-button { flex-basis: 100%; }
    .home-strip { grid-template-columns: 1fr 1fr; gap: 9px; }
    .home-strip span:not(:first-child), .home-strip span:last-child { text-align: left; }
    .home-concepts dl > div { grid-template-columns: 1fr; gap: 7px; }
  }
</style>
