---
import Base from '../layouts/Base.astro';
import StudioNav from '../components/StudioNav.astro';
import StudioFooter from '../components/StudioFooter.astro';
import { templates } from '../data/templates';
import { restaurant } from '../data/restaurant';
---
<Base
  title="Folio Resto — una web propia para tu restaurante"
  theme="studio"
  description="Plantillas abiertas y guías prácticas para restaurantes argentinos que quieren tener su propia web, carta y canal directo."
  structuredData={[
    {
      '@type': 'Organization',
      '@id': 'https://folio.unwoke.ninja/#organization',
      name: 'Folio Resto',
      url: 'https://folio.unwoke.ninja/',
      email: 'hola@unwoke.ninja',
      areaServed: { '@type': 'Country', name: 'Argentina' },
      sameAs: ['https://github.com/ashtonmorrow/resto-templates'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://folio.unwoke.ninja/#website',
      url: 'https://folio.unwoke.ninja/',
      name: 'Folio Resto',
      inLanguage: 'es-AR',
      publisher: { '@id': 'https://folio.unwoke.ninja/#organization' },
    },
  ]}
>
  <StudioNav />
  <header class="top wrap">
    <p class="eyebrow">Web propia · Restaurantes de Argentina</p>
    <h1 class="top__title">Tu restaurante.<br />Tu sitio. Tus reglas.</h1>
    <p class="top__sub muted">
      Elegí una de 15 bases, reemplazá los datos con ayuda de Claude, Codex o la herramienta que prefieras
      y publicala en una cuenta propia. Si no querés hacerlo vos, te ayudamos de forma puntual.
    </p>
    <div class="top__actions">
      <a class="btn" href="/hacerlo-vos/">Quiero hacerlo yo <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#plantillas">Ver las 15 plantillas</a>
    </div>
  </header>

  <section class="paths wrap" aria-labelledby="paths-title">
    <div class="paths__intro">
      <p class="eyebrow">Dos caminos</p>
      <h2 id="paths-title">La propiedad no cambia.</h2>
      <p class="muted">En ambos casos, el dominio, el código y las cuentas quedan a nombre del restaurante.</p>
    </div>
    <a class="path-card" href="/hacerlo-vos/">
      <span>01 · Gratis</span>
      <h3>Hacerlo vos</h3>
      <p>Copiá el proyecto público, abrilo con tu asistente y seguí una guía paso a paso.</p>
      <strong>Empezar con el código →</strong>
    </a>
    <a class="path-card" href="mailto:hola@unwoke.ninja?subject=Quiero%20una%20web%20para%20mi%20restaurante">
      <span>02 · Ayuda puntual</span>
      <h3>Te lo dejamos listo</h3>
      <p>Adaptamos una base, cargamos tu contenido y la publicamos. Trabajo independiente, alcance y precio claros.</p>
      <strong>Contarnos sobre tu local →</strong>
    </a>
  </section>

  <section class="showroom-head wrap" id="plantillas">
    <p class="eyebrow">El showroom</p>
    <h2>Un restaurante. Quince maneras de mostrarlo.</h2>
    <p class="muted">La misma marca de demostración ({restaurant.name}), la misma carta y las mismas fotos, montadas en 15 sistemas distintos.</p>
  </section>

  <main class="wrap grid" aria-label="Plantillas para restaurantes">
    {
      templates.map((t) => (
        <a class="card" href={`/t/${t.id}/`}>
          <div
            class="thumb"
            style={`--tb:${t.preview.bg};--ti:${t.preview.ink};--ta:${t.preview.accent};--tn:${t.preview.band}`}
          >
            <span class="thumb__bar" />
            <span class="thumb__h" />
            <span class="thumb__l" />
            <span class="thumb__l thumb__l--short" />
            <span class="thumb__chip">{t.menuPos}</span>
          </div>
          <div class="card__body">
            <div class="card__row">
              <span class="card__num">{t.id}</span>
              <span class="card__fits">{t.fits}</span>
            </div>
            <h2 class="card__name">{t.codename}</h2>
            <p class="card__blurb muted">{t.blurb}</p>
          </div>
        </a>
      ))
    }
  </main>

  <section class="learn wrap">
    <div>
      <p class="eyebrow">Biblioteca abierta</p>
      <h2>Antes de pagar software, entendé qué necesitás.</h2>
    </div>
    <p class="muted">Guías cortas sobre carta digital, reservas por WhatsApp, pedidos directos y cómo mantener tu stack bajo control.</p>
    <a class="btn btn--ghost" href="/guias/">Leer las guías →</a>
  </section>

  <StudioFooter />
</Base>

<style>
  .top { padding-top: clamp(58px, 10vw, 118px); padding-bottom: clamp(50px, 8vw, 90px); }
  .top__title { font-size: clamp(2.6rem, 7vw, 5.2rem); margin-top: 1rem; letter-spacing: -0.01em; }
  .top__sub { margin-top: 1.4rem; max-width: 56ch; font-size: 1.1rem; }
  .top__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .paths { display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); margin-bottom: clamp(72px, 10vw, 124px); padding: 0; }
  .paths__intro, .path-card { padding: clamp(26px, 4vw, 42px); background: var(--surface); }
  .paths__intro h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-block: 0.8rem; }
  .path-card { display: flex; flex-direction: column; align-items: flex-start; }
  .path-card > span { color: var(--accent-2); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .path-card h3 { font-size: clamp(1.5rem, 2.5vw, 2.1rem); margin-block: 1.1rem 0.7rem; }
  .path-card p { color: var(--muted); }
  .path-card strong { color: var(--accent); margin-top: auto; padding-top: 28px; font-size: 0.88rem; }
  .path-card:hover { background: var(--surface-2); }

  .showroom-head { padding-bottom: 36px; scroll-margin-top: 30px; }
  .showroom-head h2 { font-size: clamp(2rem, 4.5vw, 3.7rem); margin-block: 0.75rem 1rem; max-width: 16ch; }
  .showroom-head p:last-child { max-width: 64ch; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.2vw, 28px);
    padding-bottom: 64px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 18px 44px rgba(0,0,0,0.35); }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--tb);
    padding: 16px;
    display: block;
    overflow: hidden;
  }
  .thumb__bar { position: absolute; top: 0; left: 0; right: 0; height: 8px; background: var(--ta); }
  .thumb__h { display: block; width: 62%; height: 14px; border-radius: 4px; background: var(--ti); opacity: 0.85; margin-top: 14px; }
  .thumb__l { display: block; height: 8px; border-radius: 4px; background: var(--tn); margin-top: 10px; }
  .thumb__l--short { width: 40%; }
  .thumb__l:not(.thumb__l--short) { width: 78%; }
  .thumb__chip {
    position: absolute; left: 16px; bottom: 14px;
    font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--tb); background: var(--ta);
    padding: 0.35em 0.7em; border-radius: 999px; font-weight: 700;
  }

  .card__body { padding: 16px 18px 20px; }
  .card__row { display: flex; justify-content: space-between; align-items: center; }
  .card__num { font-family: var(--font-display); color: var(--muted); font-size: 0.9rem; letter-spacing: 0.1em; }
  .card__fits { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-2); font-weight: 600; }
  .card__name { font-size: 1.5rem; margin-top: 0.3rem; }
  .card__blurb { margin-top: 0.4rem; font-size: 0.92rem; }

  .learn { display: grid; grid-template-columns: 1.2fr 1fr auto; gap: 32px; align-items: end; padding-block: clamp(62px, 9vw, 104px); border-top: 1px solid var(--border); }
  .learn h2 { font-size: clamp(1.8rem, 3.5vw, 2.9rem); max-width: 18ch; margin-top: 0.8rem; }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .paths { grid-template-columns: 1fr 1fr; }
    .paths__intro { grid-column: 1 / -1; }
    .learn { grid-template-columns: 1fr; align-items: start; }
  }
  @media (max-width: 560px) {
    .grid, .paths { grid-template-columns: 1fr; }
    .paths__intro { grid-column: auto; }
  }
</style>
