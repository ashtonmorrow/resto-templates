---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/blocks/Nav.astro';
import Hero from '../../components/blocks/Hero.astro';
import About from '../../components/blocks/About.astro';
import Menu from '../../components/blocks/Menu.astro';
import Gallery from '../../components/blocks/Gallery.astro';
import Hours from '../../components/blocks/Hours.astro';
import Location from '../../components/blocks/Location.astro';
import Book from '../../components/blocks/Book.astro';
import SiteFooter from '../../components/blocks/SiteFooter.astro';
import { restaurant } from '../../data/restaurant';
---
<Base title={`${restaurant.name} — Restaurante en ${restaurant.neighborhood}`} theme="clean" description={restaurant.about}>
  <a id="top"></a>
  <Nav variant="solid" />
  <Hero image="/images/ambiance/modern-bright.jpg" imageAlt="Salón luminoso de Casa Rufina en Palermo" variant="compact" kicker={restaurant.kicker} title={restaurant.name} tagline={restaurant.tagline}>
    <Book />
    <a class="btn btn--ghost" href="#menu" style="color:#fff;border-color:rgba(255,255,255,.4)">Ver la carta</a>
  </Hero>
  <div class="section wrap" id="about"><About image="/images/food/asado-platter.jpg" imageAlt="Tabla de asado a la parrilla con chorizo, morcilla y chimichurri" /></div>
  <div class="band" id="menu"><div class="section wrap"><Menu variant="columns" heading="La Carta" /></div></div>
  <div class="section wrap" id="gallery"><Gallery variant="grid" heading="Galería" /></div>
  <section class="band" id="visit">
    <div class="section wrap visit">
      <Hours />
      <Location />
    </div>
  </section>
  <SiteFooter id="contacto" />
</Base>
<style>
  .band { background: var(--surface); border-block: 1px solid var(--border); }
  .visit { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  @media (max-width: 720px) { .visit { grid-template-columns: 1fr; } }
</style>
