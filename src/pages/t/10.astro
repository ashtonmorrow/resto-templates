---
import Base from '../../layouts/Base.astro';
import Book from '../../components/blocks/Book.astro';
import Img from '../../components/Img.astro';
import { restaurant } from '../../data/restaurant';
const postres = restaurant.menu.find((m) => m.name === 'Postres')!;
const pics = ['/images/food/flan.jpg', '/images/food/alfajores.jpg', '/images/detail/table-flatlay.jpg'];
---
<Base title={`${restaurant.name} — Dulces y postres`} theme="sweet" description={restaurant.about}>
  <header class="sweet-hero wrap">
    <div class="sweet-hero__text">
      <p class="eyebrow">{restaurant.neighborhood} · Postres</p>
      <h1>{restaurant.name}</h1>
      <p class="sweet-hero__tag">{restaurant.tagline}</p>
      <Book label="Encargar por WhatsApp" />
    </div>
    <figure class="sweet-hero__img"><Img src="/images/food/alfajores.jpg" alt="Alfajores rellenos de dulce de leche" /></figure>
  </header>

  <main class="wrap section">
    <h2 class="prod__title">Nuestros clásicos</h2>
    <div class="prod">
      {postres.items.map((it, i) => (
        <article class="pcard">
          <div class="pcard__img"><Img src={pics[i % pics.length]} alt={it.name} /></div>
          <div class="pcard__body">
            <h3>{it.name}</h3>
            <p class="muted">{it.desc}</p>
            <b class="pcard__price">{it.price}</b>
          </div>
        </article>
      ))}
    </div>
  </main>

  <footer class="wrap sweet-foot">
    <div><b>{restaurant.address}</b><p class="muted">{restaurant.neighborhood}, {restaurant.city}</p></div>
    <a href={restaurant.instagramUrl} target="_blank" rel="noopener" class="sweet-foot__ig">{restaurant.instagram}</a>
    <span class="muted demo">Sitio de demostración</span>
  </footer>
</Base>
<style>
  .sweet-hero { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; padding-block: clamp(32px, 6vw, 72px); }
  .sweet-hero h1 { font-size: clamp(2.8rem, 7vw, 5rem); }
  .sweet-hero__tag { font-size: 1.2rem; margin: 1rem 0 1.6rem; }
  .sweet-hero__img { margin: 0; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; }
  .prod__title { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1.6rem; }
  .prod { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .pcard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .pcard__img { aspect-ratio: 4/3; }
  .pcard__body { padding: 1.3rem; }
  .pcard__body h3 { font-size: 1.3rem; }
  .pcard__price { display: inline-block; margin-top: 0.8rem; color: var(--accent); font-size: 1.15rem; }
  .sweet-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 40px 64px; flex-wrap: wrap; }
  .sweet-foot__ig { font-family: var(--font-display); font-size: 1.6rem; color: var(--accent); }
  .demo { font-size: 0.85rem; }
  @media (max-width: 820px) { .sweet-hero { grid-template-columns: 1fr; } .prod { grid-template-columns: 1fr; } }
</style>
