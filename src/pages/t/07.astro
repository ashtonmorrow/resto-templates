---
import Base from '../../layouts/Base.astro';
import Book from '../../components/blocks/Book.astro';
import Img from '../../components/Img.astro';
import { restaurant } from '../../data/restaurant';
const featured = restaurant.menu[1]; // De la parrilla
---
<Base title={`${restaurant.name} — ${restaurant.neighborhood}`} theme="playful" description={restaurant.about}>
  <main class="wrap bento">
    <section class="tile tile--hero">
      <p class="eyebrow">{restaurant.kicker}</p>
      <h1 class="hero__name">{restaurant.name}</h1>
      <p class="hero__tag">{restaurant.tagline}</p>
      <div><Book /></div>
    </section>

    <section class="tile tile--img"><Img src="/images/food/asado-platter.jpg" alt="Tabla de asado a la parrilla con chorizo, morcilla y chimichurri" /></section>

    <section class="tile tile--menu">
      <h2>{featured.name}</h2>
      <ul>
        {featured.items.map((it) => (
          <li><span>{it.name}</span><b>{it.price}</b></li>
        ))}
      </ul>
      <a href="#" onclick="return false" class="tile__link">Ver carta completa →</a>
    </section>

    <section class="tile tile--hours">
      <h3>Horarios</h3>
      {restaurant.hours.map((h) => (<p><b>{h.days}</b><br /><span class="muted">{h.time}</span></p>))}
    </section>

    <section class="tile tile--img2"><Img src="/images/food/empanadas.jpg" alt="Empanadas de carne caseras cortadas a cuchillo" /></section>

    <section class="tile tile--ig">
      <p class="eyebrow">Seguinos</p>
      <a href={restaurant.instagramUrl} target="_blank" rel="noopener" class="ig">{restaurant.instagram}</a>
    </section>

    <section class="tile tile--visit">
      <h3>Visitanos</h3>
      <p class="visit__addr">{restaurant.address}</p>
      <p class="muted">{restaurant.neighborhood}, {restaurant.city}</p>
      <p class="muted">{restaurant.phone}</p>
    </section>

    <section class="tile tile--img3"><Img src="/images/food/flan.jpg" alt="Flan mixto con dulce de leche y crema" /></section>
  </main>
  <p class="wrap demo muted">Sitio de demostración</p>
</Base>
<style>
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(120px, auto); gap: 16px; padding-block: clamp(24px, 4vw, 48px); }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; overflow: hidden; }
  .tile--img, .tile--img2, .tile--img3 { padding: 0; }
  .tile--img :global(.imgw), .tile--img2 :global(.imgw), .tile--img3 :global(.imgw) { height: 100%; min-height: 180px; }
  .tile--hero { grid-column: span 2; grid-row: span 2; background: var(--accent); color: var(--accent-ink); display: flex; flex-direction: column; justify-content: center; gap: 0.6rem; }
  .tile--hero .eyebrow { color: var(--accent-ink); opacity: 0.85; }
  .tile--hero .btn { background: var(--accent-ink); color: var(--accent); margin-top: 0.6rem; }
  .hero__name { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 0.95; }
  .hero__tag { font-size: 1.1rem; max-width: 26ch; }
  .tile--img { grid-column: span 2; grid-row: span 2; }
  .tile--menu { grid-column: span 2; }
  .tile--menu h2 { font-size: 1.5rem; margin-bottom: 0.8rem; }
  .tile--menu ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .tile--menu li { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dotted var(--border); padding-bottom: 0.4rem; }
  .tile__link { display: inline-block; margin-top: 1rem; color: var(--accent); font-weight: 700; }
  .tile--hours h3, .tile--visit h3 { font-size: 1.2rem; margin-bottom: 0.8rem; }
  .tile--hours p { margin-bottom: 0.5rem; font-size: 0.9rem; }
  .tile--ig { grid-column: span 2; background: var(--accent-2); color: #fff; display: flex; flex-direction: column; justify-content: center; }
  .tile--ig .eyebrow { color: #fff; opacity: 0.9; }
  .ig { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .visit__addr { font-weight: 700; font-size: 1.1rem; }
  .demo { padding-bottom: 48px; font-size: 0.85rem; }
  @media (max-width: 820px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .tile--hero, .tile--img, .tile--menu, .tile--ig { grid-column: span 2; }
  }
</style>
