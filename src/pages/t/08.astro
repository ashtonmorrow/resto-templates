---
import Base from '../../layouts/Base.astro';
import Book from '../../components/blocks/Book.astro';
import Menu from '../../components/blocks/Menu.astro';
import Img from '../../components/Img.astro';
import { restaurant } from '../../data/restaurant';
---
<Base title={`${restaurant.name} — Una historia a fuego lento`} theme="cinematic" description={restaurant.about}>
  <main class="snap">
    <section class="scene scene--hero">
      <Img src="/images/ambiance/parrilla-grill.jpg" alt="Brasas de quebracho al rojo vivo en la parrilla" class="scene__bg" />
      <div class="scene__scrim"></div>
      <div class="scene__content">
        <p class="eyebrow">{restaurant.kicker}</p>
        <h1>{restaurant.name}</h1>
        <p class="scene__tag">{restaurant.tagline}</p>
        <span class="scroll-hint">Deslizá ↓</span>
      </div>
    </section>

    <section class="scene scene--story">
      <div class="scene__content">
        <p class="eyebrow">Desde {restaurant.since}</p>
        <p class="big">{restaurant.about}</p>
      </div>
    </section>

    <section class="scene scene--dish">
      <Img src="/images/food/bife.jpg" alt="Bife de chorizo a la parrilla con sal gruesa" class="scene__bg" />
      <div class="scene__scrim"></div>
      <div class="scene__content">
        <p class="eyebrow">El plato de la casa</p>
        <h2>Bife de chorizo</h2>
        <p class="scene__tag">400g a las brasas, con chimichurri de la casa.</p>
      </div>
    </section>

    <section class="scene scene--menu">
      <div class="scene__content scene__content--wide"><Menu variant="columns" heading="La carta" limit={3} /></div>
    </section>

    <section class="scene scene--book">
      <div class="scene__content">
        <h2>Te esperamos</h2>
        <p class="scene__tag">{restaurant.address} · {restaurant.neighborhood}, {restaurant.city}</p>
        <div class="scene__cta"><Book /></div>
        <p class="muted demo">Sitio de demostración</p>
      </div>
    </section>
  </main>
</Base>
<style>
  .snap { height: 100vh; overflow-y: scroll; scroll-snap-type: y mandatory; }
  .scene { position: relative; min-height: 100vh; scroll-snap-align: start; display: grid; place-items: center; overflow: hidden; padding: clamp(24px, 6vw, 80px); }
  .scene__bg { position: absolute; inset: 0; }
  .scene__scrim { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
  .scene__content { position: relative; z-index: 2; text-align: center; max-width: 60ch; }
  .scene__content--wide { max-width: var(--maxw); text-align: left; width: 100%; }
  .scene h1 { font-size: clamp(3rem, 10vw, 7rem); }
  .scene h2 { font-size: clamp(2.2rem, 6vw, 4rem); }
  .scene__tag { font-size: clamp(1.1rem, 2.6vw, 1.6rem); margin-top: 1rem; color: #e7e2da; }
  .big { font-family: var(--font-lead); font-size: clamp(1.6rem, 4vw, 3rem); line-height: 1.3; margin-top: 1rem; }
  .scene--story { background: var(--surface); }
  .scene--menu { background: var(--bg); }
  .scene__cta { margin-top: 1.8rem; }
  .scroll-hint { display: block; margin-top: 2.5rem; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; }
  .demo { margin-top: 1.5rem; font-size: 0.8rem; }
</style>
