---
import Base from '../../layouts/Base.astro';
import Menu from '../../components/blocks/Menu.astro';
import Book from '../../components/blocks/Book.astro';
import Hours from '../../components/blocks/Hours.astro';
import Location from '../../components/blocks/Location.astro';
import Social from '../../components/blocks/Social.astro';
import Img from '../../components/Img.astro';
import { restaurant } from '../../data/restaurant';
---
<Base title={`${restaurant.name} — Alta cocina`} theme="luxe" description={restaurant.about}>
  <div class="split">
    <aside class="split__media">
      <Img src="/images/ambiance/dining-moody.jpg" alt="Salón a la luz de las velas para cenar en Casa Rufina" priority />
      <div class="split__brand">
        <p class="eyebrow">{restaurant.kicker}</p>
        <p class="split__name">{restaurant.name}</p>
      </div>
    </aside>

    <main class="split__scroll">
      <section class="pad intro">
        <h1 class="intro__title">{restaurant.name}</h1>
        <p class="intro__tag">{restaurant.tagline}</p>
        <div class="intro__cta"><Book /></div>
      </section>
      <section class="pad">
        <p class="eyebrow">Nosotros</p>
        <p class="lead">{restaurant.about}</p>
        <p class="muted">{restaurant.story}</p>
      </section>
      <section class="pad" id="menu"><Menu variant="list" heading="Carta" /></section>
      <section class="pad visit">
        <div><Hours /></div>
        <div><Location /></div>
      </section>
      <section class="pad foot">
        <Social />
        <p class="muted demo">Sitio de demostración · {restaurant.neighborhood}, {restaurant.city}</p>
      </section>
    </main>
  </div>
</Base>
<style>
  .split { display: grid; grid-template-columns: 45% 55%; }
  .split__media { position: sticky; top: 0; height: 100vh; }
  .split__media :global(.imgw) { height: 100%; }
  .split__brand { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.5rem; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent); color: #fff; }
  .split__name { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.4rem); }
  .split__scroll { min-width: 0; }
  .pad { padding: clamp(48px, 7vw, 96px) clamp(28px, 5vw, 72px); border-bottom: 1px solid var(--border); }
  .intro { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; }
  .intro__title { font-size: clamp(2.6rem, 6vw, 4.6rem); }
  .intro__tag { font-size: clamp(1.1rem, 2.4vw, 1.5rem); margin-top: 1rem; color: var(--muted); max-width: 30ch; }
  .intro__cta { margin-top: 2rem; }
  .lead { font-family: var(--font-lead); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.3; margin-bottom: 1rem; }
  .visit { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .foot { display: flex; flex-direction: column; gap: 1rem; border-bottom: 0; }
  .demo { font-size: 0.85rem; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .split__media { position: relative; height: 70vh; }
    .visit { grid-template-columns: 1fr; }
  }
</style>
