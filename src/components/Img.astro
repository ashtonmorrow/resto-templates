---
// Image with a themed gradient + label fallback. If the file is missing (before
// the Midjourney downloads land), the gradient shows and the layout stays intact.
interface Props {
  src: string;
  alt: string;
  class?: string;
  grad?: string;
  ratio?: string;
  priority?: boolean;
}
const { src, alt, class: className = '', grad, ratio, priority = false } = Astro.props;
const gradient = grad ?? 'var(--grad-a), var(--grad-b)';
const styleVars = `--g:${gradient};${ratio ? `aspect-ratio:${ratio};` : ''}`;
const imageKey = src.replace(/^\/images\//, '').replace(/\.[^.]+$/, '');
const optimizedBase = `/images/optimized/${imageKey}`;
---
<div class={`imgw ${className}`} style={styleVars}>
  <picture>
    <source media="(max-width: 700px)" srcset={`${optimizedBase}-640.webp`} type="image/webp" />
    <source srcset={`${optimizedBase}-full.webp`} type="image/webp" />
    <img
      src={src}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      onload="this.closest('.imgw')?.classList.add('is-loaded')"
      onerror="this.closest('.imgw')?.classList.add('is-fallback');this.remove()"
    />
  </picture>
  <span class="imgw__label" aria-hidden="true">{alt}</span>
</div>

<style>
  .imgw {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--g));
    display: block;
    width: 100%;
    height: 100%;
  }
  .imgw picture {
    width: 100%;
    height: 100%;
  }
  .imgw img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .imgw.is-loaded img { opacity: 1; }
  .imgw__label {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    color: #fff;
    mix-blend-mode: overlay;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
