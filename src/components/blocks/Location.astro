---
import { restaurant } from '../../data/restaurant';
interface Props { heading?: string | null; }
const { heading = 'Cómo llegar' } = Astro.props;
const { geo, address, neighborhood, city } = restaurant;
const maps = `https://www.google.com/maps/search/?api=1&query=${geo.lat},${geo.lng}`;
---
<div class="loc">
  {heading && <h3 class="loc__title">{heading}</h3>}
  <p class="loc__addr">{address}</p>
  <p class="muted">{neighborhood}, {city}</p>
  <p class="loc__phone muted">{restaurant.phone}</p>
  <a class="btn btn--ghost loc__btn" href={maps} target="_blank" rel="noopener">Ver en el mapa</a>
</div>
<style>
  .loc__title { font-size: 1.2rem; margin-bottom: 0.9rem; }
  .loc__addr { font-weight: 600; font-size: 1.05rem; }
  .loc__phone { margin-top: 0.4rem; }
  .loc__btn { margin-top: 1.1rem; }
</style>
