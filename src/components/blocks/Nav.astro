---
import { restaurant } from '../../data/restaurant';
interface Props {
  links?: { label: string; href: string }[];
  variant?: 'solid' | 'transparent';
  showBook?: boolean;
}
const {
  links = [
    { label: 'Nosotros', href: '#about' },
    { label: 'Carta', href: '#menu' },
    { label: 'Galería', href: '#gallery' },
    { label: 'Visitanos', href: '#visit' },
  ],
  variant = 'solid',
  showBook = true,
} = Astro.props;
const wa = `https://wa.me/${restaurant.whatsapp}?text=${encodeURIComponent(restaurant.whatsappMsg)}`;
---
<nav class={`nav nav--${variant}`}>
  <div class="nav__inner wrap">
    <a class="nav__brand" href="#top">{restaurant.name}</a>
    <div class="nav__links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    {showBook && <a class="btn nav__book" href={wa} target="_blank" rel="noopener">Reservar</a>}
  </div>
</nav>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .nav--transparent { background: transparent; border-bottom: 0; }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; }
  .nav__brand { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; }
  .nav__links { display: flex; gap: 1.6rem; font-size: 0.92rem; font-weight: 500; }
  .nav__links a:hover { color: var(--accent); }
  .nav__book { padding: 0.6em 1.1em; font-size: 0.88rem; }
  @media (max-width: 720px) { .nav__links { display: none; } }
</style>
