---
import Img from '../Img.astro';
interface Props {
  image?: string;
  imageAlt?: string;
  kicker?: string;
  title: string;
  tagline?: string;
  variant?: 'full' | 'plain' | 'compact';
  align?: 'center' | 'left';
  minh?: string;
  priority?: boolean;
}
const {
  image,
  imageAlt = '',
  kicker,
  title,
  tagline,
  variant = 'full',
  align = 'center',
  minh,
  priority = true,
} = Astro.props;
const style = minh ? `--minh:${minh}` : '';
---
{
  variant === 'plain' ? (
    <header class={`hero hero--plain hero--${align}`}>
      {kicker && <p class="eyebrow">{kicker}</p>}
      <h1 class="hero__title">{title}</h1>
      {tagline && <p class="hero__tag muted">{tagline}</p>}
      <div class="hero__cta"><slot /></div>
    </header>
  ) : (
    <header class={`hero hero--${variant} hero--${align}`} style={style}>
      {image && <Img src={image} alt={imageAlt} class="hero__bg" priority={priority} />}
      <div class="hero__scrim" />
      <div class="hero__inner">
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 class="hero__title">{title}</h1>
        {tagline && <p class="hero__tag">{tagline}</p>}
        <div class="hero__cta"><slot /></div>
      </div>
    </header>
  )
}

<style>
  .hero { position: relative; }
  .hero--full, .hero--compact {
    min-height: var(--minh, 92vh);
    display: grid;
    align-items: end;
    color: #fff;
    overflow: hidden;
  }
  .hero--compact { min-height: var(--minh, 56vh); align-items: center; }
  .hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    /* Guarantees white hero text stays legible over any photo or the
       pre-image gradient fallback, for both bottom- and center-aligned heroes. */
    background: linear-gradient(to top, rgba(0,0,0,0.72), rgba(0,0,0,0.42) 55%, rgba(0,0,0,0.4));
  }
  .hero__inner {
    position: relative; z-index: 2;
    width: 100%; max-width: var(--maxw);
    margin-inline: auto;
    padding: clamp(28px, 6vw, 72px) clamp(20px, 5vw, 48px);
  }
  .hero--center .hero__inner { text-align: center; margin-inline: auto; }
  .hero--center.hero--compact { align-items: center; }
  .hero__kicker {
    text-transform: uppercase; letter-spacing: 0.2em;
    font-size: 0.78rem; font-weight: 600; margin-bottom: 0.9rem;
    color: #fff; opacity: 0.9;
  }
  .hero__title {
    font-size: clamp(2.8rem, 9vw, 6.2rem);
    letter-spacing: -0.01em;
  }
  .hero__tag {
    margin-top: 1rem; font-size: clamp(1rem, 2.4vw, 1.4rem);
    max-width: 42ch; opacity: 0.92;
  }
  .hero--center .hero__tag { margin-inline: auto; }
  .hero__cta { margin-top: 1.8rem; display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .hero--center .hero__cta { justify-content: center; }

  /* plain (no image) */
  .hero--plain {
    padding: clamp(72px, 12vw, 160px) clamp(20px, 5vw, 48px) clamp(40px, 6vw, 72px);
    max-width: var(--maxw); margin-inline: auto;
  }
  .hero--plain.hero--center { text-align: center; }
  .hero--plain .hero__title { font-size: clamp(3rem, 10vw, 7rem); color: var(--text); }
  .hero--plain .hero__tag { margin-top: 1.2rem; font-size: clamp(1.05rem, 2.4vw, 1.5rem); }
  .hero--plain.hero--center .hero__tag { margin-inline: auto; }
</style>
