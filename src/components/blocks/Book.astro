---
import { restaurant } from '../../data/restaurant';
interface Props {
  label?: string;
  variant?: 'btn' | 'ghost' | 'block';
  message?: string;
}
const { label = 'Reservar por WhatsApp', variant = 'btn', message } = Astro.props;
const href = `https://wa.me/${restaurant.whatsapp}?text=${encodeURIComponent(message ?? restaurant.whatsappMsg)}`;
const cls = variant === 'ghost' ? 'btn btn--ghost' : variant === 'block' ? 'btn book--block' : 'btn';
---
<a class={cls} href={href} target="_blank" rel="noopener">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.6.2-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5-.1-.2-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.1 2.9.2.2 2 3.1 5 4.3.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/>
    <path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4C8.7 21.5 10.3 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.5 0-3-.4-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.4 15 4 13.5 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8z"/>
  </svg>
  {label}
</a>
<style>
  .book--block { width: 100%; justify-content: center; padding-block: 1.05em; }
</style>
